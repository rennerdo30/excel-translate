{
  "name": "excel-translate-addin",
  "version": "1.0.0",
  "private": true,
  "description": "Excel for Mac custom functions that translate cells through a local LM Studio model",
  "keywords": [
    "excel",
    "office-addin",
    "custom-functions",
    "translation",
    "lm-studio",
    "macos"
  ],
  "author": "rennerdo30",
  "license": "MIT",
  "scripts": {
    "start": "python3 scripts/dev_server.py",
    "install-manifest": "./scripts/install_manifest.sh",
    "docker:up": "./scripts/docker-up.sh",
    "docker:down": "./scripts/docker-down.sh",
    "docker:logs": "./scripts/docker-logs.sh",
    "docker:test": "./scripts/docker-test.sh",
    "excel:reset": "./scripts/reset-excel-cache.sh",
    "mac:trust-cert": "./scripts/trust-localhost-cert.sh",
    "docs:install": "cd docs && npm install",
    "docs:dev": "cd docs && npm run dev",
